{
  "manifest_version": 2,
  "name": "Petal Arc Boosts",
  "version": "1.0",
  "description": "Customize any website: color themes, custom fonts, and element zapper",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["boosts.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "petal-boosts@petalbrowser.app" }
  }
}
