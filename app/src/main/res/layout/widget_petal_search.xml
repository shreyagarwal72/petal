<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/widget_search_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_petal_widget"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/widget_icon_search"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/icon_search"
            android:contentDescription="Search" />

        <TextView
            android:id="@+id/widget_search_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="@string/widget_search_hint"
            android:textColor="#404945"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:singleLine="true"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/widget_icon_ai"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:src="@drawable/ic_auto_awesome"
            android:contentDescription="AI Search"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/widget_icon_mic"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_mic"
            android:contentDescription="Voice Search"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

</RelativeLayout>
