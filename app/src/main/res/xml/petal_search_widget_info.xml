<?xml version="1.0" encoding="utf-8"?>
<!-- Backing layout is Glance's own @layout/glance_default_layout (shipped inside the
     glance-appwidget AAR) -- the actual UI is composed at runtime in
     com.petal.browser.widget.glance.PetalSearchGlanceWidget, not in a static XML layout. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="64dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="56dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_layout"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/app_name" />
