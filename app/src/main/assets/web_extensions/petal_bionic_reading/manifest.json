{
  "manifest_version": 2,
  "name": "Petal Bionic Reader",
  "version": "1.0",
  "description": "Guides the eyes through text with artificial fixation points (bionic reading)",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bionic.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "petal-bionic-reading@petalbrowser.app" }
  }
}
