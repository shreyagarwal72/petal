<?xml version="1.0" encoding="utf-8"?>
<!-- Petal P launch animation: cookie springs open, then each part pops in (staggered). 900 ms. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_splash_p">
  <target android:name="cookie">
    <aapt:attr name="android:animation">
      <objectAnimator android:duration="900">
        <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
          <keyframe android:fraction="0" android:value="0.2" />
          <keyframe android:fraction="0.5" android:value="1" android:interpolator="@android:anim/overshoot_interpolator" />
          <keyframe android:fraction="1" android:value="1" />
        </propertyValuesHolder>
        <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
          <keyframe android:fraction="0" android:value="0.2" />
          <keyframe android:fraction="0.5" android:value="1" android:interpolator="@android:anim/overshoot_interpolator" />
          <keyframe android:fraction="1" android:value="1" />
        </propertyValuesHolder>
        <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
          <keyframe android:fraction="0" android:value="-120" />
          <keyframe android:fraction="0.85" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
          <keyframe android:fraction="1" android:value="0" />
        </propertyValuesHolder>
      </objectAnimator>
    </aapt:attr>
  </target>
  <target android:name="stem">
    <aapt:attr name="android:animation">
      <objectAnimator android:duration="900">
        <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
          <keyframe android:fraction="0" android:value="0" />
          <keyframe android:fraction="0.2" android:value="0" />
          <keyframe android:fraction="0.48" android:value="1" android:interpolator="@android:anim/overshoot_interpolator" />
          <keyframe android:fraction="1" android:value="1" />
        </propertyValuesHolder>
      </objectAnimator>
    </aapt:attr>
  </target>
  <target android:name="bowl">
    <aapt:attr name="android:animation">
      <objectAnimator android:duration="900">
        <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
          <keyframe android:fraction="0" android:value="0" />
          <keyframe android:fraction="0.255" android:value="0" />
          <keyframe android:fraction="0.535" android:value="1" android:interpolator="@android:anim/overshoot_interpolator" />
          <keyframe android:fraction="1" android:value="1" />
        </propertyValuesHolder>
        <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
          <keyframe android:fraction="0" android:value="0" />
          <keyframe android:fraction="0.255" android:value="0" />
          <keyframe android:fraction="0.535" android:value="1" android:interpolator="@android:anim/overshoot_interpolator" />
          <keyframe android:fraction="1" android:value="1" />
        </propertyValuesHolder>
        <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
          <keyframe android:fraction="0" android:value="-60" />
          <keyframe android:fraction="0.255" android:value="-60" />
          <keyframe android:fraction="0.575" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
          <keyframe android:fraction="1" android:value="0" />
        </propertyValuesHolder>
      </objectAnimator>
    </aapt:attr>
  </target>
  <target android:name="dot">
    <aapt:attr name="android:animation">
      <objectAnimator android:duration="900">
        <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
          <keyframe android:fraction="0" android:value="0" />
          <keyframe android:fraction="0.31" android:value="0" />
          <keyframe android:fraction="0.59" android:value="1" android:interpolator="@android:anim/overshoot_interpolator" />
          <keyframe android:fraction="1" android:value="1" />
        </propertyValuesHolder>
        <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
          <keyframe android:fraction="0" android:value="0" />
          <keyframe android:fraction="0.31" android:value="0" />
          <keyframe android:fraction="0.59" android:value="1" android:interpolator="@android:anim/overshoot_interpolator" />
          <keyframe android:fraction="1" android:value="1" />
        </propertyValuesHolder>
        <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
          <keyframe android:fraction="0" android:value="-60" />
          <keyframe android:fraction="0.31" android:value="-60" />
          <keyframe android:fraction="0.63" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
          <keyframe android:fraction="1" android:value="0" />
        </propertyValuesHolder>
      </objectAnimator>
    </aapt:attr>
  </target>
</animated-vector>
