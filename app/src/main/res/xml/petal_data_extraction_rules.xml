<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="petal_vault.enc" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="petal_vault.enc" />
    </device-transfer>
</data-extraction-rules>
