<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="petal_vault.enc" />
        <exclude domain="sharedpref" path="petal_sync_vault.xml" />
        <exclude domain="sharedpref" path="petal_folder_sync.xml" />
        <exclude domain="sharedpref" path="petal_fxa_logins.xml" />
        <exclude domain="file" path="petal_sync_base.json" />
        <exclude domain="file" path="petal_sync_state.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="petal_vault.enc" />
        <exclude domain="sharedpref" path="petal_sync_vault.xml" />
        <exclude domain="sharedpref" path="petal_folder_sync.xml" />
        <exclude domain="sharedpref" path="petal_fxa_logins.xml" />
        <exclude domain="file" path="petal_sync_base.json" />
        <exclude domain="file" path="petal_sync_state.json" />
    </device-transfer>
</data-extraction-rules>
