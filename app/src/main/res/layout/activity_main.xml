<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    tools:ignore="ContentDescription">

    <!-- Top Address Bar (Omnibox) -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Elevated"
        android:backgroundTint="?attr/colorSurfaceContainerHigh"
        app:cardElevation="3dp"
        app:strokeWidth="0dp"
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:layout_alignParentTop="true"
        app:cardCornerRadius="28dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/item_cardView"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="16dp"
                android:backgroundTint="@android:color/transparent"
                android:layout_gravity="center_vertical"
                app:cardCornerRadius="8dp">

                <ImageView
                    android:id="@+id/menu_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:scaleType="fitCenter"
                    tools:ignore="ContentDescription" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="110dp"
                android:id="@+id/textGroup"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/appBar_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/appbar_URL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOutline"/>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/appBar_buttons"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        tools:ignore="RelativeOverlap">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_overview"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            app:backgroundTint="?attr/colorSurfaceContainerHighest"
            app:borderWidth="0.5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/icon_tab"
            app:maxImageSize="20dp"
            app:fabCustomSize="40dp"
            app:elevation="1dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_menu"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            app:backgroundTint="?attr/colorSurfaceContainerHighest"
            app:borderWidth="0.5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:src="@drawable/icon_profile_standard"
            app:maxImageSize="20dp"
            app:fabCustomSize="40dp"
            app:elevation="1dp" />

    </LinearLayout>

    <!-- Fancy Rippling Wavy Top Loading Progress Line -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/main_progress_bar_compose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/appBar"/>

    <!-- Top Loading Progress Line -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/main_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/main_progress_bar_compose"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorSurfaceVariant"
        app:trackThickness="4dp"/>

    <!-- Main Web Content Container -->
    <FrameLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/main_progress_bar_compose"/>

    <!-- Floating Action Button for Showing Top Bar -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_showAppBar"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/icon_up"
        app:elevation="2dp"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        app:backgroundTint="?attr/colorSurfaceContainerHighest"
        app:borderWidth="0.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:maxImageSize="20dp"
        app:fabCustomSize="42dp"
        android:visibility="gone"/>

    <!-- Search On Site Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchOnSiteLayout"
        android:visibility="gone"
        style="@style/Widget.Material3.CardView.Elevated"
        android:backgroundTint="?attr/colorSurfaceContainerHigh"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_margin="12dp"
        android:layout_alignParentTop="true"
        app:cardCornerRadius="28dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/searchOnSite_buttonClose"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                android:layout_marginEnd="10dp"
                app:icon="@drawable/icon_close" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchOnSite_textField"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:layout_toStartOf="@+id/searchOnSite_buttonClose"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:paddingBottom="5dp"
                android:paddingTop="5dp"
                android:hint="@string/menu_other_searchSite"
                app:boxCornerRadiusTopStart="24dp"
                app:boxCornerRadiusTopEnd="24dp"
                app:boxCornerRadiusBottomStart="24dp"
                app:boxCornerRadiusBottomEnd="24dp"
                app:boxStrokeWidth="0.8dp"
                app:boxStrokeWidthFocused="1.5dp"
                app:startIconDrawable="@drawable/icon_up"
                app:endIconDrawable="@drawable/icon_down"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/searchOnSite_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text|textUri"
                    android:selectAllOnFocus="true"/>

            </com.google.android.material.textfield.TextInputLayout>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Persistent Floating Stride Bottom Navigation Bar (Floating Overlay) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/bottom_nav_compose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:elevation="16dp"/>
    <!-- Small Circular Floating Bubble for Collapsed Address Bar (Bottom-Right) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fab_bubble"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="90dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        android:backgroundTint="?attr/colorSurfaceContainerHighest">

        <ImageView
            android:id="@+id/bubble_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/icon_secure"
            app:tint="?attr/colorPrimary"
            tools:ignore="ContentDescription"/>

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>