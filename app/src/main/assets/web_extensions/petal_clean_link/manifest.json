{
    "manifest_version": 2,
    "name": "Petal Clean Link",
    "version": "1.0.0",
    "description": "Automatically removes tracking tokens and marketing parameters from clicked links.",
    "browser_specific_settings": {
        "gecko": {
            "id": "petal-clean-link@petalbrowser.app"
        }
    },
    "permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["clean_link.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ]
}
