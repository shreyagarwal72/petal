<?xml version="1.0" encoding="utf-8"?>
<!-- Petal Search (Liquid Glass).
     The root has NO padding on purpose: the baked glass bitmap must cover exactly the widget's
     on-screen rectangle, otherwise the refraction no longer lines up with the wallpaper behind
     it. Only the foreground row is padded. Colours of text/icons are set at runtime
     (auto light/dark contrast) by PetalLiquidGlassWidgetBinder. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/petal_liquid_glass_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Baked liquid glass. src = instant frosted placeholder until the first bake lands. -->
    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/petal_liquid_glass_placeholder_bg" />

    <LinearLayout
        android:id="@+id/widget_glass_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/btn_petal_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/widget_ic_search_sparkle"
            android:contentDescription="@string/ui_petal" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/btn_search_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="@string/widget_search_hint"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/btn_search_bar_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:contentDescription="@string/widget_search_hint"
                android:visibility="gone" />

        </FrameLayout>

        <ImageView
            android:id="@+id/btn_voice_search"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/widget_ic_mic"
            android:contentDescription="@string/widget_voice_search" />

        <ImageView
            android:id="@+id/btn_lens_camera"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/widget_ic_lens_camera"
            android:contentDescription="@string/quick_tile_scanner_label" />

        <ImageView
            android:id="@+id/btn_incognito"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/widget_ic_incognito"
            android:contentDescription="@string/ui_new_incognito_tab" />

    </LinearLayout>

</FrameLayout>
