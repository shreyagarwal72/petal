<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network & Connectivity -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.NFC" />

    <!-- Haptics, Audio & Media Capture -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Geolocation -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Storage & Modern Media Permissions (Android 13+) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Security & Biometrics (WebAuthn / Passkeys) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Shortcuts & Desktop Integration -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!-- Foreground Services -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Queries for Google Lens, Google App and 1DM Downloader integration -->
    <queries>
        <package android:name="com.google.ar.lens" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.apps.photos" />
        <package android:name="idm.internet.download.manager" />
        <package android:name="idm.internet.download.manager.adm.lite" />
        <package android:name="idm.internet.download.manager.plus" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="googlelens" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="googleapp" />
        </intent>
    </queries>

    <application
        android:name=".PetalApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        tools:ignore="GoogleAppIndexingWarning">

        <!-- Central Opt-Out for WebView Metrics -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!-- AppLocales Metadata Holder Service for AppCompat auto-store locales -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <service
            android:name="com.petal.browser.media.PetalMediaSessionService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <service
            android:name="com.petal.browser.compose.downloads.PetalDownloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <activity
            android:name="com.petal.browser.activity.BrowserActivity"
            android:theme="@style/Theme.Petal.Splash"
            android:configChanges="orientation|uiMode|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize"
            android:fitsSystemWindows="false"
            android:exported="true"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Fängt jede Form von Text- und Code-Struktur ab (inkl. .txt, .html etc.) -->
                <data android:mimeType="text/*" />
                <!-- Sicherheitsnetz für Dateimanager, die JSON/XML als App-Typ statt Text deklarieren -->
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
            </intent-filter>

            <!-- 2. FILTER: Fängt alle anderen Dateien (inkl. .org) ab, bei denen der Mime-Type unbekannt ist -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <!-- Verpflichtend, damit Android die URI unabhängig vom Namen an die App übergibt -->
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Text über das Android 'Teilen'-Menü empfangen -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Launcher-Eintrag & Systemweite Websuche -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Erlaubt es, markierten Text aus anderen Apps direkt im FOSS-Browser zu öffnen -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <!--
          Einstellungs-Activities:
          WICHTIG ab Android 12+: Müssen explizit android:exported="false" deklariert werden,
          da sie nur App-intern aufgerufen werden und sonst ein Sicherheitsrisiko darstellen!
        -->
        <activity android:name="com.petal.browser.activity.Settings_Activity" android:label="@string/setting_title_browser" android:exported="false" />
        <activity android:name="com.petal.browser.activity.Settings_ProfileList" android:label="@string/setting_title_savedWebSites" android:exported="false" />
        <activity android:name="com.petal.browser.activity.Settings_Delete" android:label="@string/menu_delete" android:exported="false" />
        <activity android:name="com.petal.browser.activity.Settings_Backup" android:label="@string/setting_title_data" android:exported="false" />
        <activity android:name="com.petal.browser.activity.Settings_Gesture" android:label="@string/setting_gestures" android:exported="false" />
        <activity android:name="com.petal.browser.activity.Settings_Filter" android:label="@string/setting_filter" android:exported="false" />
        <activity android:name="com.petal.browser.activity.Settings_Profile" android:label="@string/setting_title_profiles_standard" android:exported="false" />
        <activity android:name="com.petal.browser.activity.Settings_Menu" android:label="@string/setting_menu" android:exported="false" />

        <receiver
            android:name="com.petal.browser.compose.downloads.PetalDownloadCancelReceiver"
            android:exported="false" />

        <receiver
            android:name="com.petal.browser.widget.glance.PetalSearchGlanceWidgetReceiver"
            android:label="@string/widget_quick_search_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/petal_search_widget_info" />
        </receiver>

        <receiver
            android:name="com.petal.browser.widget.glance.PetalShortcutsGlanceWidgetReceiver"
            android:label="@string/widget_shortcuts_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/petal_shortcuts_widget_info" />
        </receiver>

        <receiver
            android:name="com.petal.browser.widget.glance.PetalExpressiveGlanceWidgetReceiver"
            android:label="@string/widget_expressive_bar_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/petal_expressive_widget_info" />
        </receiver>

        <receiver
            android:name="com.petal.browser.widget.glance.PetalModeSwitchGlanceWidgetReceiver"
            android:label="@string/widget_mode_switch_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/petal_mode_switch_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

    </application>

</manifest>
