<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 Expressive – Autofill suggestion chip (RemoteViews-compatible) -->
<!--
  NOTE: RemoteViews does NOT support:
  - ?attr/color… attributes (theme attributes don't resolve in RemoteViews)
  - ConstraintLayout
  Colors reference @color/ which resolve correctly per night/light configuration.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/petal_autofill_chip_bg">

    <!-- Material 3 Expressive Key/Lock Badge Container -->
    <LinearLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:gravity="center"
        android:background="@drawable/petal_autofill_badge_bg">
        <ImageView
            android:id="@+id/petal_autofill_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/icon_secure"
            android:tint="@color/petal_autofill_accent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- Text column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/petal_autofill_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textColor="@color/petal_autofill_title" />

        <TextView
            android:id="@+id/petal_autofill_domain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:textColor="@color/petal_autofill_subtitle" />

    </LinearLayout>

    <!-- Petal brand label pill -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Petal"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/petal_autofill_accent"
        android:layout_marginStart="8dp" />

</LinearLayout>
