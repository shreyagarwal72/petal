<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/widget_search_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_petal_widget"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/widget_icon_search"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search"
            android:contentDescription="Search" />

        <TextView
            android:id="@+id/widget_search_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="Search or Ask AI..."
            android:textColor="#808080"
            android:textSize="15sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/widget_icon_ai"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_ai_stars"
            android:contentDescription="Ask AI"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/widget_icon_mic"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_mic"
            android:contentDescription="Voice Search"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</RelativeLayout>
