<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) only. system_accent1_* are public platform resources
  exposing the wallpaper-derived Material You palette directly — no root,
  Shizuku, ADB, or "Themed icons" launcher setting required. Overrides the
  static fallbacks in values/colors.xml on devices that support them.
-->
<resources>
    <color name="dynamic_icon_bg">@android:color/system_accent1_100</color>
    <color name="dynamic_icon_fg">@android:color/system_accent1_800</color>

    <!-- Material 3 Expressive Autofill Dynamic Colors (Android 12+ / Light) -->
    <color name="petal_autofill_dialog_bg">@android:color/system_neutral1_10</color>
    <color name="petal_autofill_surface_container">@android:color/system_neutral1_50</color>
    <color name="petal_autofill_chip_bg">@android:color/system_neutral1_20</color>
    <color name="petal_autofill_chip_stroke">@android:color/system_accent1_200</color>
    <color name="petal_autofill_badge_bg">@android:color/system_accent1_100</color>
    <color name="petal_autofill_title">@android:color/system_neutral1_900</color>
    <color name="petal_autofill_subtitle">@android:color/system_neutral2_700</color>
    <color name="petal_autofill_caption">@android:color/system_neutral2_500</color>
    <color name="petal_autofill_accent">@android:color/system_accent1_600</color>
    <color name="petal_autofill_pill_bg">@android:color/system_accent1_100</color>
</resources>
