<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    tools:ignore="ContentDescription">

    <!-- Main Web Content Container: fills viewport (top and bottom aligned), and dynamically offset by address bar / bottom bar via paddings and layout rules -->
    <FrameLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"/>

    <!-- Fancy Rippling Wavy Loading Progress Line: overlay above content and address bar (top/bottom) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/main_progress_bar_compose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="30dp"/>

</RelativeLayout>
