{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/site/index.html"
    },
    {
      "source": "/(styles\\.css|app\\.js|robots\\.txt|sitemap\\.xml|site\\.webmanifest|favicon\\.ico|google[a-zA-Z0-9]+\\.html)",
      "destination": "/site/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/site/assets/$1"
    },
    {
      "source": "/site",
      "destination": "/site/index.html"
    },
    {
      "source": "/site/(.*)",
      "destination": "/site/$1"
    }
  ]
}
