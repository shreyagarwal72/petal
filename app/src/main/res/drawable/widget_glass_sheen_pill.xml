<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass overlay for pill-shaped widgets (28dp corners).
     Pure shape drawable: renders at any widget size with zero bitmap memory, so it can't
     blow the RemoteViews binder limit the way the old wallpaper-blur bitmaps did. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft top-lit sheen (light refracting through the upper edge) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.45" />
        </shape>
    </item>
    <!-- Bottom caustic: faint warm light bleeding up from the lower edge -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:startColor="#1AFFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.25" />
        </shape>
    </item>
    <!-- Specular rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1.25dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <!-- Inner refraction ring (second, dimmer edge just inside the rim) -->
    <item
        android:bottom="1.25dp"
        android:left="1.25dp"
        android:right="1.25dp"
        android:top="1.25dp">
        <shape android:shape="rectangle">
            <corners android:radius="26.75dp" />
            <stroke android:width="0.75dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
</layer-list>
