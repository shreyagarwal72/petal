<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Optional status-bar mode for the Petal NowBar. Declared only in the non-Play build
             (Google Play restricts accessibility services to accessibility tools). Off until the
             user enables it in system Accessibility settings. Reads no screen content. -->
        <service
            android:name="com.petal.browser.island.PetalIslandAccessibilityService"
            android:exported="false"
            android:label="@string/petal_island_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/petal_island_accessibility_config" />
        </service>

        <!-- Google AdMob Application ID for GitHub release build -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-5680314597533936~2825634534" />
    </application>
</manifest>
