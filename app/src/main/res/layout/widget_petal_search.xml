<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:padding="2dp">

    <LinearLayout
        android:id="@+id/widget_search_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_petal_widget"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/widget_icon_search"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_search"
            android:contentDescription="Search" />

        <TextView
            android:id="@+id/widget_search_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:text="Search or type web address"
            android:textColor="#5F6368"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:singleLine="true"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/widget_icon_ai"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_ai_stars"
            android:contentDescription="AI Search"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_icon_mic"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_mic"
            android:contentDescription="Voice Search"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</RelativeLayout>
