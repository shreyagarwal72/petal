<?xml version="1.0" encoding="utf-8"?>
<!-- Petal Pill (Liquid Glass). Same rules as the search layout: no root padding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/petal_liquid_glass_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/petal_liquid_glass_placeholder_bg" />

    <LinearLayout
        android:id="@+id/widget_glass_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/btn_petal_logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:src="@drawable/widget_ic_search"
            android:contentDescription="@string/ui_petal" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/btn_search_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="@string/widget_search_hint"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/btn_search_bar_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:contentDescription="@string/widget_search_hint"
                android:visibility="gone" />

        </FrameLayout>

        <ImageView
            android:id="@+id/btn_voice_search"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:src="@drawable/widget_ic_mic"
            android:contentDescription="@string/widget_voice_search" />

        <ImageView
            android:id="@+id/btn_lens_camera"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:src="@drawable/widget_ic_lens_camera"
            android:contentDescription="@string/quick_tile_scanner_label" />

    </LinearLayout>

</FrameLayout>
